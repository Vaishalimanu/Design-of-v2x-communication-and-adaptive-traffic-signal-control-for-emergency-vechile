/**

  * @brief  The application entry point.

  * @retval int

  */

int main(void)

{



  /* USER CODE BEGIN 1 */



  /* USER CODE END 1 */



  /* MCU Configuration--------------------------------------------------------*/



  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */

  HAL_Init();



  /* USER CODE BEGIN Init */



  /* USER CODE END Init */



  /* Configure the system clock */

  SystemClock_Config();



  /* USER CODE BEGIN SysInit */



  /* USER CODE END SysInit */



  /* Initialize all configured peripherals */

  MX_GPIO_Init();

  MX_USART2_UART_Init();

  MX_USART1_UART_Init();

  MX_USART6_UART_Init();

  MCP2515_Reset();
  HAL_Delay(100);


  /* USER CODE BEGIN 2 */

  memset(&gps_data, 0, sizeof(GPS_Data));

  /* USER CODE END 2 */



  /* Infinite loop */

  /* USER CODE BEGIN WHILE */

  while (1)

  {

		  uint8_t signalByte;



		  while(HAL_UART_Receive(&huart6, &signalByte, 1, 0) == HAL_OK)

		  {

		      if(signalByte <= 2)

		      {

		          trafficSignal = signalByte;



		          if(trafficSignal != lastTrafficSignal)

		          {

		              lastTrafficSignal = trafficSignal;



		              char msg[40];

		              sprintf(msg, "Signal = %d\r\n", trafficSignal);



		              HAL_UART_Transmit(&huart2,

		                                (uint8_t *)msg,

		                                strlen(msg),

		                                HAL_MAX_DELAY);

		          }

		      }

		  }

	  if(HAL_GetTick() - speed_timer >= 1000)

	  {

	      speed_timer = HAL_GetTick();



	      if(trafficSignal == 2)        // GREEN

	      {

	          vehicle_speed++;



	          if(vehicle_speed > 80)

	              vehicle_speed = 20;

	      }

	      else if(trafficSignal == 1)   // YELLOW

	      {

	          vehicle_speed = 10;

	      }

	      else                          // RED

	      {

	          vehicle_speed = 0;

	      }

	  }

      /************* Brake Button *************/

      if(HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_13) == GPIO_PIN_RESET)

          brake_status = 1;

      else

          brake_status = 0;



      /************* Receive GPS *************/

      HAL_UART_Receive(&huart1,

                       &gps_byte,

                       1,

                       HAL_MAX_DELAY);



      if(gps_byte == '$')

      {

          gps_index = 0;

          gps_buffer[gps_index++] = gps_byte;

      }

      else if(gps_index > 0)

      {

          if(gps_byte == '\n')

          {

              gps_buffer[gps_index] = '\0';



              GPS_Parse(gps_buffer, &gps_data);

              if(gps_data.fix == 0)
              {
                  gps_index = 0;
                  continue;
              }



              /************* CAN GPS Frame *************/

              int32_t lat = (int32_t)(gps_data.latitude * 100000);

              int32_t lon = (int32_t)(gps_data.longitude * 100000);



              can_gps_frame[0] = (lat >> 24) & 0xFF;

              can_gps_frame[1] = (lat >> 16) & 0xFF;

              can_gps_frame[2] = (lat >> 8) & 0xFF;

              can_gps_frame[3] = lat & 0xFF;



              can_gps_frame[4] = (lon >> 24) & 0xFF;

              can_gps_frame[5] = (lon >> 16) & 0xFF;

              can_gps_frame[6] = (lon >> 8) & 0xFF;

              can_gps_frame[7] = lon & 0xFF;



              MCP2515_SendMessage(0x100, can_gps_frame, 8);



              /************* CAN Status Frame *************/

              can_status_frame[0] = (vehicle_speed >> 8) & 0xFF;

              can_status_frame[1] = vehicle_speed & 0xFF;

              can_status_frame[2] = brake_status;

              can_status_frame[3] = emergency_status;

              can_status_frame[4] = 0;

              can_status_frame[5] = 0;

              can_status_frame[6] = 0;

              can_status_frame[7] = 0;



              MCP2515_SendMessage(0x101, can_status_frame, 8);



              /************* Print to PC *************/

              if(HAL_GetTick() - print_timer >= 1000)

              {

                  print_timer = HAL_GetTick();



                  char msg[200];



                  sprintf(msg,

                          "\r\n====== VEHICLE 2 ======\r\n"

                          "Signal    : %s\r\n"

                          "Latitude  : %.5f\r\n"

                          "Longitude : %.5f\r\n"

                          "Speed     : %d km/h\r\n"

                          "Brake     : %s\r\n"

                          "Emergency : %s\r\n"

                          "Satellites: %d\r\n"

                          "=======================\r\n",

                          trafficSignal==0 ? "RED" :

                          trafficSignal==1 ? "YELLOW" : "GREEN",

                          gps_data.latitude,

                          gps_data.longitude,

                          vehicle_speed,

                          brake_status ? "ON" : "OFF",

                          emergency_status ? "YES" : "NO",

                          gps_data.satellites);

                  HAL_UART_Transmit(&huart2,

                                    (uint8_t *)msg,

                                    strlen(msg),

                                    HAL_MAX_DELAY);

              }



              /************* Send to ESP32 (USART6) *************/

              if(HAL_GetTick() - uartTimer >= 1000)

              {

                  uartTimer = HAL_GetTick();



                  char esp_msg[100];



                  sprintf(esp_msg,

                          "%.5f,%.5f,%d,%d,%d\r\n",

                          gps_data.latitude,

                          gps_data.longitude,

                          vehicle_speed,

                          brake_status,

                          emergency_status);



                  HAL_UART_Transmit(&huart6,

                                    (uint8_t *)esp_msg,

                                    strlen(esp_msg),

                                    HAL_MAX_DELAY);

              }



              gps_index = 0;

          }

          else

          {

              if(gps_index < sizeof(gps_buffer) - 1)

              {

                  gps_buffer[gps_index++] = gps_byte;

              }

              else

              {

                  gps_index = 0;

              }

          }

      }



    /* USER CODE END WHILE */



    /* USER CODE BEGIN 3 */

  }

  /* USER CODE END 3 */

}



