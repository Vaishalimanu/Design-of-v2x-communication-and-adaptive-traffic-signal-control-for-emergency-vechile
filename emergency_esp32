#include <RadioLib.h>

#define BUTTON_PIN 4

SX1262 radio = new Module(5, 26, 14, 25);

void setup() {

  Serial.begin(115200);

  pinMode(BUTTON_PIN, INPUT_PULLUP);

  if (radio.begin(915.0) != RADIOLIB_ERR_NONE) {
    Serial.println("LoRa Failed");
    while (1);
  }

  Serial.println("Emergency Vehicle Ready");
}

void loop() {

  if (digitalRead(BUTTON_PIN) == LOW) {

    int state = radio.transmit("EMERGENCY");

    if (state == RADIOLIB_ERR_NONE) {
      Serial.println("Emergency Sent");
    }

    delay(500);
  }
}
